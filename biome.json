{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/*.config.ts",
			"**/e2e/**/*",
			"**/scripts/**/*",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useTailwindShorthandClasses": { "level": "error", "fix": "safe" },
				"useTailwindVariablesShorthand": { "level": "error", "fix": "safe" },
				"useTailwindSortedClasses": {
					"level": "error",
					"fix": "safe"
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/src/components/ui/**"],
			"linter": {
				"rules": {
					"nursery": {
						"useTailwindSortedClasses": "off",
						"useTailwindShorthandClasses": "off",
						"useTailwindVariablesShorthand": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"tailwind": { "mergeFunctions": ["cn"], "variantFunctions": ["cva"] }
}
